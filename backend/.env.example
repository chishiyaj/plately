# Plately V2 — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development          # development | production
PORT=5000
SECRET_KEY=change-this-to-a-long-random-string-in-production

# ── CORS (production only) ────────────────────────────────────────────────────
# Leave blank in development (allows all origins).
# In production, set to your frontend domain: https://plately.app
ALLOWED_ORIGINS=

# ── Waitress (production WSGI) ────────────────────────────────────────────────
HOST=0.0.0.0
WAITRESS_THREADS=8

# ── API Keys ──────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=           # https://openrouter.ai — free tier, Gemma 3 27B
                               # Used for: AI Chat + Image Scan (vision)
